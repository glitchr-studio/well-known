<?xml version="1.0" encoding="UTF-8"?>
<!-- Kept compatible with both PHPUnit 10 (CI, require-dev) and PHPUnit 9.6
     (host app's simple-phpunit bridge, mirroring base-bundle's harness) —
     the old filter/whitelist syntax and vendor/autoload.php bootstrap only
     worked if this bundle were installed standalone, which it never is. -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         bootstrap="Tests/bootstrap.php"
         colors="true">
    <php>
        <ini name="error_reporting" value="-1" />
        <ini name="intl.default_locale" value="en" />
        <ini name="intl.error_level" value="0" />
        <env name="SHELL_VERBOSITY" value="-1" />
    </php>

    <testsuites>
        <testsuite name="unit">
            <directory>Tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>.</directory>
        </include>
        <exclude>
            <directory>Tests</directory>
            <directory>Resources</directory>
            <directory>vendor</directory>
        </exclude>
    </source>
</phpunit>
